{
  "meta": {
    "title": "Your Name | Developer",
    "description": "Personal portfolio website",
    "favicon": "./favicon.svg"
  },
  "defaultTheme": "dark",
  "themes": {
    "dark": {
      "primaryColor": "#6C63FF",
      "secondaryColor": "#FF6584",
      "bgColor": "#0F0F13",
      "surfaceColor": "#1A1A24",
      "textColor": "#E8E8F0",
      "mutedColor": "#888899",
      "fontBody": "'Inter', system-ui, sans-serif",
      "fontMono": "'Fira Code', 'Cascadia Code', monospace"
    },
    "light": {
      "primaryColor": "#5A52E0",
      "secondaryColor": "#E84D6A",
      "bgColor": "#F5F5FA",
      "surfaceColor": "#FFFFFF",
      "textColor": "#1A1A2E",
      "mutedColor": "#6B6B80",
      "fontBody": "'Inter', system-ui, sans-serif",
      "fontMono": "'Fira Code', 'Cascadia Code', monospace"
    }
  },
  "nav": {
    "logo": "",
    "sticky": true,
    "links": [
      { "label": "About", "href": "#about", "enabled": true },
      { "label": "Skills", "href": "#skills", "enabled": true },
      { "label": "Experience", "href": "#experience", "enabled": true },
      { "label": "Projects", "href": "#projects", "enabled": true },
      { "label": "Education", "href": "#education", "enabled": true },
      { "label": "Contact", "href": "#contact", "enabled": true }
    ]
  },
  "sections": {
    "hero": { "enabled": true, "showScrollIndicator": true },
    "about": { "enabled": true },
    "skills": { "enabled": true },
    "experience": { "enabled": true },
    "projects": { "enabled": true, "showAll": false },
    "education": { "enabled": true },
    "contact": { "enabled": true }
  },
  "footer": {
    "enabled": true,
    "text": "Built with React. Data-driven portfolio."
  }
}
